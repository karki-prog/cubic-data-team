AUTH_JWT_SECRET=
# false (default) = @AUTH_ALLOWED_DOMAIN + AUTH_EXTRA_EMAILS + Current_Market emails
#   (MongoDB allow-list, refreshed by webhook / sync).
# true = any verified Google account (emergency open gate only).
AUTH_ALLOW_ANY_GOOGLE=false
AUTH_ALLOWED_DOMAIN=cubicit.net
# Staff-level sign-ins outside @cubicit.net (staff views in tracker / attendance)
AUTH_EXTRA_EMAILS=
# Sign-in allowed, candidate-level access only
AUTH_CANDIDATE_EMAILS=shaksham78karki@gmail.com
# Must be a "Web application" OAuth client, with this exact Authorized redirect URI:
#   {AUTH_SITE_URL}/api/auth/callback
# A Desktop/"installed" client will fail with Error 400: redirect_uri_mismatch.
# Falls back to oauth-web.json ({"web":{...}}) if unset.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AUTH_SITE_URL=http://localhost:3000
CRON_SECRET=
# Site caches (hiring, DNA, allow-list, booking queue) live in MongoDB.
# JSON files under data/ are imported once, then unused.
MONGODB_URI=mongodb://127.0.0.1:27017/cubic_data
# CUBIC_DNA_WEBHOOK_URL=http://localhost:3000/api/webhooks/do-not-apply
# Manual refresh of the copy from Cubic:
#   curl -X POST http://localhost:3000/api/jobs/do-not-apply-sync
# Job Hiring: UI reads MongoDB. Apply_Links edits POST:
# CUBIC_HIRING_WEBHOOK_URL=http://localhost:3000/api/webhooks/job-postings
# Manual refresh of the copy from Apply_Links:
#   curl -X POST http://localhost:3000/api/jobs/job-postings-sync
# Allowed users: non-@cubicit.net sign-in from Current_Market col L.
# CUBIC_ACCESS_WEBHOOK_URL=http://localhost:3000/api/webhooks/allowed-users
# Manual refresh:
#   curl -X POST http://localhost:3000/api/jobs/allowed-users-sync
# Local only: Application Tracker loads this candidate instead of your session email.
# CUBIC_TRACKER_MOCK_EMAIL=bsthapa.arya@gmail.com
# Unset in normal operation so thank-you mail goes to the candidate + POC CC.
# Set to an inbox to redirect every booking email (no CC):
# BOOKING_TEST_EMAIL=karki@cubicit.net
BOOKING_USE_APPS_SCRIPT=false
# Rust is the only public HTTP server (API + UI).
RUST_BACKEND_PORT=3000
# next dev (internal). npm run dev sets this. Leave unset when serving out/.
CUBIC_UI_ORIGIN=http://127.0.0.1:3001
# Optional. If out/ exists after `next build`, Rust serves it automatically.
# CUBIC_STATIC_DIR=out
